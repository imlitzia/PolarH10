        self.root.destroy()
        batch_process_files(self.files, options)

def get_next_version_folder():
    # Find the highest existing version folder
    existing_folders = glob.glob("V_*")
    versions = [int(folder.split("_")[1]) for folder in existing_folders if folder.split("_")[1].isdigit()]
    
    if not versions:
        next_version = 1
    else:
        next_version = max(versions) + 1
    
    # Create the new version folder
    new_folder = f"V_{next_version}"
    os.makedirs(new_folder, exist_ok=True)
    print(f"Created output folder: {new_folder}")
    return new_folder

def process_time_column(filepath, output_folder):
    try:
        name = os.path.splitext(os.path.basename(filepath))[0]
        df = pd.read_csv(filepath)

        time_col = get_first_matching_column(df, ["time", "Time", "UNIX Timestamp", "timestamp"])
        if time_col is None:
            raise ValueError(
                f"The file '{name}' does not contain a supported time column "
                f"(time/Time/UNIX Timestamp/timestamp)."
            )

        time = pd.to_numeric(df[time_col], errors="coerce")
        if time.isna().all():
            raise ValueError(f"The time column '{time_col}' in '{name}' is not numeric.")

        # Keep a standard lowercase name for downstream processing.
        df["time"] = time
        df["norm_time"] = (time - time.iloc[0]) / 1e10  # Normalize time

        output_file = os.path.join(output_folder, f"{name}_timeadjusted.csv")
        df.to_csv(output_file, index=False)
        print(f"Time-adjusted file saved as: {output_file}")
        return output_file, df
    
    except Exception as e:
        print(f"Error processing time column in '{filepath}': {e}")
        return None, None

def chnk(lst, n, step):
    """Yield successive n-sized chunks from lst."""
    for i in range(0, len(lst)-n, step):
        print(f'Chunking raw data ... {(i/len(lst))*100:.1f}%')
        yield lst[i:i + n]

def remove_outliers_from_data(hrv_data):
    """Remove outliers from HRV data using IQR method"""
    for col in ['HRV_LF', 'HRV_HF', 'HRV_LFHF']:
        if col in hrv_data.columns:
            Q1 = hrv_data[col].quantile(0.25)
            Q3 = hrv_data[col].quantile(0.75)
            IQR = Q3 - Q1
            lower_bound = Q1 - 1.5 * IQR
            upper_bound = Q3 + 1.5 * IQR
            
            # Create a mask for values that are not outliers
            mask = (hrv_data[col] >= lower_bound) & (hrv_data[col] <= upper_bound)
            
            # Replace outliers with NaN and then interpolate
            hrv_data.loc[~mask, col] = np.nan
            hrv_data[col] = hrv_data[col].interpolate(method='linear')
    
    return hrv_data

def smooth_data(data, window_size):
    return data.rolling(window=window_size, min_periods=1).mean()

def process_ecg_file(df, name, output_folder, options):
    try:
        if "HRV_LFHF" in df.columns:
            print(f"File '{name}' already contains HRV data. Skipping processing and plotting graph.")
            return df
        
        ecg_col = get_first_matching_column(df, ["ecg", "ECG"])
        if ecg_col is None:
            raise ValueError(f"The file '{name}' does not contain an ECG column (ecg/ECG).")
        
        raw = pd.to_numeric(df[ecg_col], errors="coerce")
        raw = raw.dropna()
        if raw.empty:
            raise ValueError(f"The ECG column '{ecg_col}' in '{name}' does not contain numeric values.")
        _SAMPLING_RATE = 100
        _SAMPLING_STEP = 10
        chunksize = 5000
        
        chnks = chnk(raw, chunksize, _SAMPLING_STEP)
        newarr = [data for data in chnks]
        
        hrv_data = pd.DataFrame()
        
        for index, data in enumerate(newarr):
            print(f'Calculating HRV features for {name} ... {(index/len(newarr))*100:.1f}%')
            clean = nk.ecg_clean(data, sampling_rate=130)
            peaks = nk.ecg_peaks(clean, sampling_rate=130)
            hrv = nk.hrv_frequency(peaks[1], sampling_rate=130)
            hrv["time"] = (index*_SAMPLING_STEP) * 1/_SAMPLING_RATE
            hrv_data = pd.concat([hrv_data, hrv])
        
        # Apply outlier removal if selected
        if options['remove_outliers']:
            print(f"Removing outliers from {name}...")
            hrv_data = remove_outliers_from_data(hrv_data)
        
        # Apply smoothing if selected
        if options['apply_smoothing']:
            window_size = options['window_size']
            print(f"Applying smoothing with window size {window_size} to {name}...")
            hrv_data["HRV_LFHF"] = smooth_data(hrv_data["HRV_LFHF"], window_size=window_size)
        
        output_file = os.path.join(output_folder, f"{name}_with_hrv.csv")
        hrv_data.to_csv(output_file, index=False)
        print(f"HRV data file saved as: {output_file}")
        
        return hrv_data
    
    except Exception as e:
        print(f"Error processing ECG data for '{name}': {e}")
        return None

def plot_hrv(df, name, output_folder, options):
    plt.figure(figsize=(10, 6))
    plt.title(f"LFHF Ratio {name}")
    plt.xlabel("Time(Sec)")
    plt.ylabel("LFHF Ratio(mW)")
    
    # Add processing information
    info_text = f"Outlier Removal: {'Yes' if options['remove_outliers'] else 'No'}\n"
    info_text += f"Smoothing: {'Yes' if options['apply_smoothing'] else 'No'}"
    if options['apply_smoothing']:
        info_text += f" (Window: {options['window_size']})"
    
    plt.text(0.02, 0.02, info_text, fontsize=8, transform=plt.gcf().transFigure)
    
    plt.grid(visible=True, which='major', axis='both')
    plt.plot(df["time"], df["HRV_LFHF"])
    
    # Save the plot to file instead of showing it
    plot_file = os.path.join(output_folder, f"{name}_hrv_plot.png")
    plt.savefig(plot_file, dpi=300, bbox_inches='tight')
    plt.close()
    print(f"HRV plot saved as: {plot_file}")

def batch_process_files(files, options):
    # Create version folder
    output_folder = get_next_version_folder()
    
    # Save processing options to a text file
    with open(os.path.join(output_folder, "processing_options.txt"), "w") as f:
        f.write(f"Remove Outliers: {options['remove_outliers']}\n")
        f.write(f"Apply Smoothing: {options['apply_smoothing']}\n")
        f.write(f"Smoothing Window Size: {options['window_size']}\n")
    
    # First pass: process time columns for all files
    adjusted_files = []
    for file in files:
        adjusted_file, df = process_time_column(file, output_folder)
        if adjusted_file:
            adjusted_files.append((adjusted_file, df, os.path.splitext(os.path.basename(adjusted_file))[0]))
    
    # Second pass: process all ECG data
    for adjusted_file, df, name in adjusted_files:
        hrv_data = process_ecg_file(df, name, output_folder, options)
        if hrv_data is not None:
            plot_hrv(hrv_data, name, output_folder, options)
    
    print(f"Batch processing complete. All results saved in {output_folder}")

