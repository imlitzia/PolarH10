import pandas as pd
import os
import tkinter as tk
from tkinter import filedialog

def process_file(filepath):
    try:
        name = os.path.splitext(os.path.basename(filepath))[0]
        df = pd.read_csv(filepath)

        timestamp_col = None
        for candidate in ["UNIX Timestamp", "time", "timestamp", "unix_time"]:
            if candidate in df.columns:
                timestamp_col = candidate
                break

        if timestamp_col is None:
            raise ValueError(
                f"The file '{name}' does not contain a supported timestamp column "
                f"(expected one of: UNIX Timestamp, time, timestamp, unix_time)."
            )

        raw_time = pd.to_numeric(df[timestamp_col], errors="coerce")
        if raw_time.isna().all():
            raise ValueError(f"Timestamp column '{timestamp_col}' in '{name}' is not numeric.")

        # Detect unit from magnitude: Polar exports are often nanoseconds.
        max_abs = raw_time.dropna().abs().max()
        if max_abs >= 1e17:
            unit = "ns"
        elif max_abs >= 1e14:
            unit = "us"
        elif max_abs >= 1e11:
            unit = "ms"
        else:
            unit = "s"

        # Convert UNIX epoch to timezone-aware UTC datetimes.
        dt_utc = pd.to_datetime(raw_time, unit=unit, origin="unix", utc=True)
        # Also include a local-time view for easier reading.
        dt_local = dt_utc.dt.tz_convert(None)

        df["datetime_utc"] = dt_utc.dt.strftime("%Y-%m-%d %H:%M:%S.%f UTC")
        df["datetime_local"] = dt_local.dt.strftime("%Y-%m-%d %H:%M:%S.%f")
        df["elapsed_seconds"] = (raw_time - raw_time.iloc[0]) / {
            "ns": 1e9,
            "us": 1e6,
            "ms": 1e3,
            "s": 1.0,
        }[unit]

        output_file = f"{name}_time_converted.csv"
        df.to_csv(output_file, index=False)
        print(f"Processed '{name}' using unit '{unit}'.")
        print(f"File saved as: {output_file}")
    
    except FileNotFoundError:
        print(f"Error: File '{filepath}' not found.")
    except ValueError as e:
        print(f"Error: {e}")
    except Exception as e:
        print(f"Unexpected error in '{filepath}': {e}")

# Open file dialog to select multiple CSV files
tk.Tk().withdraw()  # Hide the root window
files = filedialog.askopenfilenames(title="Select CSV Files", filetypes=[("CSV files", "*.csv")])

if files:
    for file in files:
        process_file(file)
else:
    print("No files selected.")
